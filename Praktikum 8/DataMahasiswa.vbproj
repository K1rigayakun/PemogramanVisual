<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DataMahasiswa</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmUtama.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmUtama.Designer.vb">
      <DependentUpon>FrmUtama.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FrmUtama.resx">
      <DependentUpon>FrmUtama.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="FrmDariArray.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmDariArray.Designer.vb">
      <DependentUpon>FrmDariArray.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FrmDariArray.resx">
      <DependentUpon>FrmDariArray.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="FrmDariList.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmDariList.Designer.vb">
      <DependentUpon>FrmDariList.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FrmDariList.resx">
      <DependentUpon>FrmDariList.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="FrmDataTable.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmDataTable.Designer.vb">
      <DependentUpon>FrmDataTable.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FrmDataTable.resx">
      <DependentUpon>FrmDataTable.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="FrmCariList.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmCariList.Designer.vb">
      <DependentUpon>FrmCariList.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FrmCariList.resx">
      <DependentUpon>FrmCariList.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
